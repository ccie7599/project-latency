FROM golang:1.25-alpine AS builder
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-s -w" -o /hub ./cmd/hub

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=builder /hub /usr/local/bin/hub
ENTRYPOINT ["/usr/local/bin/hub"]
