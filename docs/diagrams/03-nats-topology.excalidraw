      "seed": 34
    },
    {
      "type": "text",
      "id": "subject-text",
      "x": 70,
      "y": 925,
      "text": "latency.\n├── probe.request.<region>         Req/Reply  (target responds)\n├── results.<source>.<target>      Pub/Sub    (agent → hub)\n├── control.\n│   ├── schedule                   Pub/Sub    (hub → all agents)\n│   └── probe.<region>             Pub/Sub    (hub → one agent)\n└── health.<region>                Pub/Sub    (agent heartbeat)",
      "fontSize": 13,
      "fontFamily": 3,
      "strokeColor": "#1e1e1e",
      "seed": 35
    },
    {
      "type": "text",
      "id": "leaf-label",
      "x": 350,
