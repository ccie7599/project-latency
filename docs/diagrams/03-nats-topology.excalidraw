    {
      "type": "text",
      "id": "flow-note",
      "x": 50,
      "y": 790,
      "text": "RTT includes: us-east → us-ord → fr-par → us-ord → us-east\nThis measures NATS application-layer latency, not direct network latency.\nHub routing adds ~1-2ms overhead.",
      "fontSize": 13,
      "fontFamily": 3,
      "strokeColor": "#868e96",
      "seed": 32
    },
    {
      "type": "text",
      "id": "subject-title",
      "x": 50,
      "y": 880,
