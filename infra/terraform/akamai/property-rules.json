{
  "rules": {
    "name": "default",
    "children": [
      {
        "name": "Static Assets",
        "criteria": [
          {
            "name": "fileExtension",
            "options": {
              "matchOperator": "IS_ONE_OF",
              "values": ["js", "css", "jpg", "png", "gif", "ico", "svg", "woff", "woff2", "ttf"],
              "matchCaseSensitive": false
            }
          }
        ],
        "behaviors": [
          {
            "name": "caching",
            "options": {
              "behavior": "MAX_AGE",
              "mustRevalidate": false,
              "ttl": "1h"
            }
          }
        ],
        "criteriaMustSatisfy": "all"
      },
      {
        "name": "API — No Cache",
        "criteria": [
          {
            "name": "path",
            "options": {
              "matchOperator": "MATCHES_ONE_OF",
              "values": ["/api/*", "/ping"],
              "matchCaseSensitive": false,
              "normalize": false
            }
          }
        ],
        "behaviors": [
          {
            "name": "caching",
            "options": {
              "behavior": "NO_STORE"
            }
          },
          {
            "name": "downstreamCache",
            "options": {
              "behavior": "BUST"
            }
          }
        ],
        "criteriaMustSatisfy": "all"
      },
      {
        "name": "WebSocket",
        "criteria": [
          {
            "name": "path",
            "options": {
              "matchOperator": "MATCHES_ONE_OF",
              "values": ["/ws/*"],
              "matchCaseSensitive": false,
              "normalize": false
            }
          }
        ],
        "behaviors": [
          {
            "name": "webSockets",
            "options": {
              "enabled": true
            }
          },
          {
            "name": "caching",
            "options": {
              "behavior": "NO_STORE"
            }
          }
        ],
        "criteriaMustSatisfy": "all"
      }
    ],
    "behaviors": [
      {
        "name": "origin",
        "options": {
          "originType": "CUSTOMER",
          "hostname": "${env.origin_hostname}",
          "httpPort": 80,
          "httpsPort": 443,
          "forwardHostHeader": "ORIGIN_HOSTNAME",
          "cacheKeyHostname": "ORIGIN_HOSTNAME",
          "compress": true,
          "enableTrueClientIp": true,
          "trueClientIpHeader": "True-Client-IP",
          "trueClientIpClientSetting": false,
          "originSni": true,
          "verificationMode": "PLATFORM_SETTINGS",
          "minTlsVersion": "DYNAMIC",
          "http2Enabled": false,
          "ipVersion": "IPV4"
        }
      },
      {
        "name": "cpCode",
        "options": {
          "value": {
            "id": ${env.cp_code_id}
          }
        }
      },
      {
        "name": "caching",
        "options": {
          "behavior": "NO_STORE"
        }
      },
      {
        "name": "http2",
        "options": {}
      },
      {
        "name": "sureRoute",
        "options": {
          "enabled": true,
          "type": "PERFORMANCE",
          "forceSslForward": true,
          "testObjectUrl": "/sureroute-test-object.txt"
        }
      }
    ],
    "options": {
      "is_secure": true
    }
  }
}
